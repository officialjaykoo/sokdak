{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sokdak",
	"account_id": "22d65a8944c8f50915f993a079b4f302",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sokdak-db",
			"database_id": "ce42ca70-7e6a-48ff-b54e-cd44a6bde092",
			"migrations_dir": "./migrations"
		}
	],
	// Optional — app falls back to isolate memory if omitted
	// "kv_namespaces": [{ "binding": "CACHE", "id": "...", "preview_id": "..." }],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PostObject"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ChatRoom"]
		},
		{
			"tag": "v3",
			"deleted_classes": ["PostObject"]
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "sokdak-media"
		}
	],
	"vars": {
		"BETTER_AUTH_URL": "https://sokdak.kr",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
		"NEXTJS_ENV": "production",
		"KAKAO_CLIENT_ID": "055c7ca94e809f9f322d85a8f23fcf99"
	},
	"triggers": {
		"crons": ["0 3 * * *"]
	},
	"workers_dev": true,
	// Custom-domain routes are intentionally unset for now.
	// Add the sokdak.kr route here when the domain is attached.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		}
	},
	"ratelimits": [
		{
			"name": "EDGE_IP_RATE_LIMITER",
			"namespace_id": "91001",
			"simple": {
				"limit": 400,
				"period": 60
			}
		},
		{
			"name": "TUNNEL_IP_RATE_LIMITER",
			"namespace_id": "91002",
			"simple": {
				"limit": 90,
				"period": 60
			}
		},
		{
			"name": "EXPENSIVE_IP_RATE_LIMITER",
			"namespace_id": "91003",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	]
}
