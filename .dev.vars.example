NEXTJS_ENV=development
BETTER_AUTH_SECRET=dev-secret-must-be-at-least-32-chars!!
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated browser origins for preview/custom domains:
# SOKDAK_AUTH_ORIGINS=https://preview.example.com
#
# Social OAuth — Kakao requires the client ID; the client secret is optional
# unless it is enabled in the Kakao app.
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Naver requires the client ID and client secret from the Naver Developers app.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# Cloudflare Turnstile — use your own keys, or these always-pass test keys locally:
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Optional compatibility fallback; prefer NEXT_PUBLIC_TURNSTILE_SITE_KEY.
# TURNSTILE_SITE_KEY=

# Web Push (optional locally; generate one VAPID P-256 key pair)
# VAPID_PUBLIC_KEY=base64url-uncompressed-P256-public-key
# VAPID_PRIVATE_KEY=base64url-P256-private-scalar
# VAPID_SUBJECT=mailto:ops@example.com

# Production: set secrets with Wrangler (never commit the real values)
#   wrangler secret put BETTER_AUTH_SECRET
#   wrangler secret put TURNSTILE_SECRET_KEY
#   wrangler secret put KAKAO_CLIENT_SECRET  # optional when enabled in Kakao
#   wrangler secret put NAVER_CLIENT_SECRET  # required for Naver login
#   VAPID_PUBLIC_KEY is a public Worker var; do not store it with `secret put`.
#   wrangler secret put VAPID_PRIVATE_KEY
#   wrangler secret put VAPID_SUBJECT

# E2E_BOT_BYPASS and NEXT_PUBLIC_E2E_BOT_BYPASS are injected by Playwright.
# Do not enable them in a shared or production environment.
