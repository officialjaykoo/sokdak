{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sokdak-vitest",
	"main": "./tests/workers/test-worker.ts",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat"],
	"vars": {
		"BETTER_AUTH_SECRET": "test-secret"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sokdak-test",
			"database_id": "local-db-id",
			"migrations_dir": "./migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "sokdak-test-media"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "CHAT_ROOM",
				"class_name": "ChatRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["PostObject"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["ChatRoom"]
		},
		{
			"tag": "v3",
			"deleted_classes": ["PostObject"]
		}
	]
}
